# dashboard/backend/.env — copy to `.env` and fill in.
#
# NOTE: there is no PORT here on purpose. index.js hardcodes port 9999; a PORT
# value in this file is read by nothing. The frontend is likewise hardcoded to
# 48317 in its `start` script.

# --- Required. supabaseClient.js calls process.exit(1) if either is missing ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Security. Both fall back to hardcoded dev defaults if unset. Set them. ---
JWT_SECRET=<long-random-string>
SESSION_SECRET=<long-random-string>
# `production` switches session cookies to secure-only
NODE_ENV=development

# --- AWS: S3 media for snag photos, voice notes and resolution proof ---
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_REGION=eu-north-1
S3_BUCKET_NAME=<bucket-name>

# Used to build fallback URLs when a media file is served from local uploads/
BASE_URL=http://localhost:9999

# Where WhatsApp deep links point. Must be reachable by the phone opening them.
FRONTEND_URL=http://localhost:48317

# --- AI chat: the Lambda Function URL that /api/chat proxies to ---
CHAT_LAMBDA_URL=https://<function-url>.lambda-url.eu-north-1.on.aws/

# --- Meta WhatsApp Cloud API (dashboard notifications) ---
WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>
WHATSAPP_ACCESS_TOKEN=<meta-access-token>
WHATSAPP_WABA_ID=<whatsapp-business-account-id>
# Must match the language of the approved templates or Meta returns error 132001
WHATSAPP_TEMPLATE_LANG=en_US
# Public HTTPS bounce page for template URL buttons. Meta rejects http:// and
# private IPs, so this cannot point straight at a LAN dashboard.
TEMPLATE_VIEW_JOB_BASE=https://<your-domain>/foresite-redirect
