# chatbot/.env — copy to `.env` and fill in.
#
# The filename must be EXACTLY `.env`. A trailing space (`.env `) is silently
# ignored by dotenv and nothing loads — including PORT, which has no fallback.

# Server. `server.js` reads process.env.PORT with NO default: if this is unset
# Node binds a random port and your ngrok tunnel hits nothing.
PORT=4545

# Supabase (Postgres only — no Auth, Storage or Realtime is used)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>

# AWS — S3 holds snag photos and voice notes
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_REGION=eu-north-1
S3_BUCKET_NAME=<bucket-name>

# Meta WhatsApp Cloud API.
#
# NOTE: these two are lowercase and case-sensitive — `controller.js` reads
# process.env.accessToken and process.env.phone_number_id. The startup warning
# in controller.js mentions WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID,
# but nothing reads those names. Use the lowercase ones below.
#
# The token from WhatsApp > API Setup is TEMPORARY (24h). When it expires the
# bot still receives messages but fails to reply with
# `code: 190 OAuthException`. See docs/SETUP.md for the permanent System User
# token that stops the daily breakage.
accessToken=<meta-access-token>
phone_number_id=<meta-phone-number-id>
