# lambda-agent/.env — values for LOCAL runs of the test_*.py scripts.
#
# In production these are set as AWS Lambda function environment variables,
# not from a file. There is no dotenv dependency here — export them into your
# shell (e.g. `set -a; source .env; set +a`) before running the tests.

# Read connection. Transaction pooler (port 6543). db.py forces
# statement_timeout=10000 on this one.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Write connection, used for chat_session / chat_message persistence.
# Defaults to SUPABASE_DB_URL in the test scripts if unset.
SUPABASE_DB_WRITE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Google Gemini — the agent calls this directly via google-genai (not Bedrock)
GEMINI_API_KEY=<gemini-api-key>
# Optional; agent_loop.py defaults to gemini-2.0-flash
GEMINI_MODEL_ID=gemini-2.0-flash

# Optional — only used by test_conn.py to compare connection methods
SUPABASE_DB_SESSION_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
